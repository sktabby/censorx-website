Options -Indexes
DirectoryIndex index.html

# Unknown URLs: real 404 status. 404.html is the empty app shell, so the app shows "Page not found".
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Force HTTPS (only for the live domain, so staging hosts are not sent to production).
RewriteCond %{HTTP_HOST} ^(www\.)?censorx\.in$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://censorx.in%{REQUEST_URI} [L,R=301]

# 2. One host: www -> non-www.
RewriteCond %{HTTP_HOST} ^www\.censorx\.in$ [NC]
RewriteRule ^ https://censorx.in%{REQUEST_URI} [L,R=301]

# 3. Old legal URLs -> the standalone pages (permanent).
RewriteRule ^legal/privacy-policy/?$ /privacy/ [R=301,L]
RewriteRule ^legal/terms/?$ /terms/ [R=301,L]

# 4. One URL per page: drop the trailing slash (real folders keep theirs).
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 5. Hashed build assets can be cached for a year.
RewriteRule ^assets/ - [E=CX_ASSET:1]

# 6. Serve real files and folders (the static legal pages) as they are.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 7. Prerendered pages: /features -> /features.html (when that file exists).
RewriteCond %{REQUEST_URI} !^/(404|index)/?$ [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# 8. Fallback for any other app route: the empty app shell.
RewriteRule ^(roles|privacy|features|download|user-guide|roadmap|use-cases|why-it-matters|faq|contact|career|team|about|schools|terms|delete-account|legal/disclaimer)/?$ /404.html [L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
Header set Cache-Control "public, max-age=31536000, immutable" env=CX_ASSET
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
