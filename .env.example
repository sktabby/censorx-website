# Copy this file to .env.local and fill in the values.
# Restart the Vite dev server after changing it.

# Apps Script web app URL (ends in /exec) for apps-script/career-form-proxy.gs
VITE_CAREER_FORM_PROXY=

# Apps Script web app URL (ends in /exec) for apps-script/contact-forms.gs
# Used by the School partnership and Feedback forms on the Contact page.
VITE_CONTACT_FORM_PROXY=
